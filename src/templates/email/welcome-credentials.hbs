<!-- backend/src/templates/email/welcome-credentials.hbs -->

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #4f46e5; color: white; padding: 20px; text-align: center; }
    .content { padding: 20px; background: #f9fafb; }
    .credentials { background: white; padding: 15px; border-radius: 5px; margin: 20px 0; }
    .credential-item { margin: 10px 0; }
    .label { font-weight: bold; color: #4f46e5; }
    .button { 
      background: #4f46e5; 
      color: white; 
      padding: 12px 24px; 
      text-decoration: none; 
      border-radius: 5px;
      display: inline-block;
    }
    .qr-section {
      text-align: center;
      margin: 30px 0;
      padding: 20px;
      background: white;
      border-radius: 5px;
    }
    .qr-code {
      max-width: 200px;
      margin: 0 auto;
    }
    .footer { text-align: center; padding: 20px; color: #666; font-size: 12px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Welcome to {{instituteName}}!</h1>
    </div>
    
    <div class="content">
      <p>Dear <strong>{{name}}</strong>,</p>
      
      <p>Your account has been created successfully. Below are your login credentials:</p>
      
      <div class="credentials">
        <div class="credential-item">
          <span class="label">User Type:</span> {{userType}}
        </div>
        
        {{#if registrationNo}}
        <div class="credential-item">
          <span class="label">Registration/Employee No:</span> {{registrationNo}}
        </div>
        {{/if}}
        
        <div class="credential-item">
          <span class="label">Email:</span> {{email}}
        </div>
        
        <div class="credential-item">
          <span class="label">Password:</span> <strong>{{password}}</strong>
        </div>
      </div>
      
      <!-- QR Code Section -->
      <div class="qr-section">
        <h3>Your Digital Identity QR Code</h3>
        <div class="qr-code">
          <img src="cid:qrcode" alt="QR Code" style="max-width: 200px; height: auto;">
        </div>
        <p style="margin-top: 10px; font-size: 14px; color: #666;">
          Scan this code for quick identification and access
        </p>
        {{#if qrCodeUrl}}
        <p style="font-size: 12px;">
          <a href="{{qrCodeUrl}}" target="_blank">Download QR Code</a>
        </p>
        {{/if}}
      </div>
      
      <p style="text-align: center; margin: 30px 0;">
        <a href="{{loginUrl}}" class="button">Login to Your Account</a>
      </p>
      
      <p><strong>Important:</strong></p>
      <ul>
        <li>Please change your password after first login</li>
        <li>Keep your credentials secure</li>
        <li>The QR code can be used for attendance, library access, and identification</li>
      </ul>
      
      <p>If you have any questions, please contact the administration.</p>
      
      <p>Best regards,<br>{{instituteName}} Team</p>
    </div>
    
    <div class="footer">
      <p>This is an automated message. Please do not reply to this email.</p>
      <p>&copy; {{instituteName}} {{year}}</p>
    </div>
  </div>
</body>
</html>